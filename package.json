  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "generate:assets": "node scripts/generate-assets.mjs",
    "dev": "vite --host 127.0.0.1",
